{
  "name": "dolumu-live",
  "private": true,
  "description": "The website's /api/live/* routes as a small Node server on the Hetzner server (see docs/reference/deployment.md).",
  "scripts": {
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --target=node24 --alias:server-only=./server-only.ts --outfile=dist/server.cjs --log-level=warning",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "typescript": "~5.9"
  }
}
